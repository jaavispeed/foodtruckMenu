# ==============================================================================
# .gitignore para Menú Food Truck
# ==============================================================================

# Respaldos y archivos temporales
*.bak
*.tmp
*.temp
*~
*.swp

# Carpetas y archivos de agentes y skills
.agent/
.agents/
_agents/
_agent/
skills-lock.json

# Entornos, credenciales y secretos
.env
.env.*
*.env
*.key
*.pem
*.cert
secrets/
credentials.json

# Archivos de logs y depuración
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Archivos y carpetas del sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDEs y editores
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
